def integerTreeMatrix (t : Fin 125) : Matrix (Fin 4) (Fin 4) ℤ :=
  fun i j => integerGenerators (treeEdges t j) i

def treeHeight (e : Fin 10) : ℤ := 2 ^ e.val

def treeCost (t : Fin 125) (e : Fin 10) : ℤ :=
  treeHeight e - dotProduct (treeNormal t) (integerGenerators e)

