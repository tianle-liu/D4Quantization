theorem secondary_entries (w : Nat → ℝ) :
    secondaryForm cone3Vectors (w 0) (fun j => w j.succ.val) = !![2*w 0+w 1+w 5+w 6+w 9,w 0+w 9,-w 0-w 5-w 9,-w 0-w 6-w 9;
      w 0+w 9,2*w 0+w 2+w 7+w 8+w 9,-w 0-w 7-w 9,-w 0-w 8-w 9;
      -w 0-w 5-w 9,-w 0-w 7-w 9,2*w 0+w 3+w 5+w 7+w 9,w 9;
      -w 0-w 6-w 9,-w 0-w 8-w 9,w 9,2*w 0+w 4+w 6+w 8+w 9] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [secondaryForm, rankOne, cone3Vectors, gramMatrix, Fin.sum_univ_succ] <;>
      ring
