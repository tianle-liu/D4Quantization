import D4.NearestPoint
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Topology.MetricSpace.HausdorffDistance
import Mathlib.Data.Real.StarOrdered

/-!
# The actual Euclidean meaning of the Gram nearest-point function

The realization uses the genuine `EuclideanSpace` norm. Its lattice is
the image of all integer coordinate vectors. These statements identify
pointwise squared distance to that lattice with the analytic Gram
function; they do not assert a change-of-variables formula for integrals.
-/

noncomputable section
namespace D4.Euclidean
open Matrix Analytic

abbrev Point := EuclideanSpace ℝ (Fin 4)

/-- The physical point obtained by applying the coordinate matrix B. -/
def realization (B : Gram) (v : Vec) : Point :=
  (WithLp.equiv 2 Vec).symm (B *ᵥ v)

/-- The actual Gram matrix of the columns of B. -/
def gram (B : Gram) : Gram := Bᵀ * B

/-- The full integer lattice generated by the columns of B. -/
def lattice (B : Gram) : Set Point :=
  Set.range (fun z : IntVec => realization B (castVec z))

theorem lattice_nonempty (B : Gram) : (lattice B).Nonempty :=
  ⟨realization B (castVec 0), ⟨0, rfl⟩⟩

theorem realization_sub (B : Gram) (v w : Vec) :
    realization B (v - w) = realization B v - realization B w := by
  apply (WithLp.equiv 2 Vec).injective
  change B *ᵥ (v - w) = B *ᵥ v - B *ᵥ w
  exact Matrix.mulVec_sub B v w

/-- The Euclidean squared norm is exactly the quadratic form BᵀB. -/
theorem norm_sq_realization (B : Gram) (v : Vec) :
    ‖realization B v‖ ^ 2 = quadratic (gram B) v := by
  rw [← real_inner_self_eq_norm_sq]
  unfold realization
  rw [EuclideanSpace.inner_piLp_equiv_symm]
  simp only [star_trivial]
  unfold quadratic gram
  symm
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]

/-- Distances between physical points use the Gram quadratic form. -/
theorem squared_dist_eq_quadratic (B : Gram) (v w : Vec) :
    dist (realization B v) (realization B w) ^ 2 = quadratic (gram B) (v - w) := by
  rw [dist_eq_norm, ← realization_sub, norm_sq_realization]

/-- Equality of the infimum over all genuine squared Euclidean distances
and the analytic nearest-point function, even before a rank assumption. -/
theorem iInf_squared_dist_eq_nearest (B : Gram) (v : Vec) :
    (⨅ z : IntVec, dist (realization B v) (realization B (castVec z)) ^ 2) =
      nearest (gram B) v := by
  simp only [squared_dist_eq_quadratic, nearest]

/-- An injective coordinate matrix has positive definite Gram matrix. -/
theorem gram_posDef (B : Gram) (hB : Function.Injective B.mulVec) :
    (gram B).PosDef := by
  simpa only [gram, Matrix.conjTranspose_eq_transpose_of_trivial, Matrix.mul_one] using
    (Matrix.PosDef.one : (1 : Gram).PosDef).conjTranspose_mul_mul_same hB

/-- For a full-rank coordinate matrix, the square of the actual metric
distance to the integer lattice is the Gram nearest-point function. -/
theorem infDist_sq_eq_nearest (B : Gram) (hB : Function.Injective B.mulVec) (v : Vec) :
    Metric.infDist (realization B v) (lattice B) ^ 2 = nearest (gram B) v := by
  have hQ := gram_posDef B hB
  obtain ⟨z, hz⟩ := nearest_point_exists hQ v
  have hd (w : IntVec) :
      dist (realization B v) (realization B (castVec z)) ≤
        dist (realization B v) (realization B (castVec w)) := by
    apply (sq_le_sq₀ dist_nonneg dist_nonneg).mp
    simpa only [squared_dist_eq_quadratic] using hz w
  have hi : Metric.infDist (realization B v) (lattice B) =
      dist (realization B v) (realization B (castVec z)) := by
    apply le_antisymm (Metric.infDist_le_dist_of_mem
      (show realization B (castVec z) ∈ lattice B from ⟨z, rfl⟩))
    apply (Metric.le_infDist (lattice_nonempty B)).mpr
    rintro y ⟨w, rfl⟩
    exact hd w
  rw [hi, squared_dist_eq_quadratic]
  exact (le_antisymm (nearest_le hQ.posSemidef v z) (le_ciInf hz)).symm

end D4.Euclidean
