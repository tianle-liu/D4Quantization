theorem principal_normals_sign : ∀ (s : Fin 24) (k : Fin 10),
    principalNormals s k=principalIntegerGenerators k ∨
    principalNormals s k= -principalIntegerGenerators k := by decide +kernel

theorem principal_normals_tight : ∀ (s : Fin 24) (k : Fin 10) (i : Fin 5),
    quadraticZ (generators1 k) (cells1 s i)=dotProduct (cells1 s i) (principalNormals s k) := by decide +kernel

